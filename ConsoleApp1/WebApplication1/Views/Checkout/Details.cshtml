@model WebApplication1.Models.Entities.Transaction

@{
    ViewData["Title"] = "Transaction Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0"><i class="bi bi-file-earmark-text me-2 text-info"></i>Transaction Details</h2>
        <a asp-controller="Checkout" asp-action="History" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to History
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white py-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <small class="text-uppercase text-light opacity-75">Transaction ID</small>
                    <h5 class="mb-0 text-warning font-monospace">@Model.TransactionId</h5>
                </div>
                <div class="col-md-6 text-md-end">
                    <small class="text-uppercase text-light opacity-75">Date</small>
                    <h6 class="mb-0">@Model.TransactionDate.ToString("F")</h6>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h6 class="text-muted text-uppercase">Billed To</h6>
                    <h5 class="fw-bold mb-1">@Model.CustomerName</h5>
                    <p class="text-muted mb-0"><i class="bi bi-envelope me-1"></i>@Model.CustomerEmail</p>
                </div>
            </div>

            <h5 class="fw-bold mb-3">Purchased Items</h5>
            <div class="table-responsive mb-3">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Item Name</th>
                            <th class="text-center">Unit Price</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@item.ProductName</td>
                                <td class="text-center">$@item.UnitPrice.ToString("F2")</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end fw-semibold">$@item.Subtotal.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-end">
                <span class="fs-5 text-muted me-2">Grand Total Paid:</span>
                <span class="fs-3 fw-bold text-success">$@Model.TotalAmount.ToString("F2")</span>
            </div>
        </div>
    </div>
</div>