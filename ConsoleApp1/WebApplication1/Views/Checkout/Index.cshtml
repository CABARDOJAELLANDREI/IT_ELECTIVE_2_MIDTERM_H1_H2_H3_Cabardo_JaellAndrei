@model WebApplication1.Models.DTOs.CheckoutFormDTO
@{
    ViewData["Title"] = "Secure Checkout";
    var cart = ViewBag.Cart as WebApplication1.Models.Entities.ShoppingCart;
}

<div class="container mt-4">
    <div class="row g-4 justify-content-center">
        <!-- Customer Form -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h4 class="fw-extrabold mb-1"><i class="bi bi-person-bounding-box text-primary me-2"></i>Shipping Details</h4>
                <p class="text-muted small mb-4">Please fill in your receipt contact details.</p>

                <form asp-controller="Checkout" asp-action="ProcessCheckout" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Full Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-person"></i></span>
                            <input asp-for="CustomerName" class="form-control border-start-0 py-2" placeholder="e.g. Peter Parker" />
                        </div>
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                            <input asp-for="CustomerEmail" class="form-control border-start-0 py-2" placeholder="peter@dailybugle.com" />
                        </div>
                        <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-checkout btn-lg w-100 py-3 fw-bold shadow-sm">
                        Place Order ($@cart?.TotalAmount.ToString("F2"))
                    </button>
                </form>
            </div>
        </div>

        <!-- Sidebar Summary -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                <h5 class="fw-bold mb-3">Order Items</h5>
                @if (cart != null)
                {
                    <div class="list-group list-group-flush bg-transparent mb-3">
                        @foreach (var item in cart.Items)
                        {
                            <div class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <h6 class="mb-0 fw-bold">@item.ProductName</h6>
                                    <small class="text-muted">Qty: @item.Quantity × $@item.UnitPrice.ToString("F2")</small>
                                </div>
                                <span class="fw-bold text-dark">$@item.Subtotal.ToString("F2")</span>
                            </div>
                        }
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5">Total</span>
                        <span class="fs-4 fw-extrabold text-success">$@cart.TotalAmount.ToString("F2")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>