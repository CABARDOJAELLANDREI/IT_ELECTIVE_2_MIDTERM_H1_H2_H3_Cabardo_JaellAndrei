<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Multiverse Comics & Collectibles</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-accent: #6366f1;
            --primary-hover: #4f46e5;
            --secondary-accent: #ff4757;
            --bg-canvas: #0f172a;
            --card-bg: #1e293b;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
        }

        /* Top Announcement Bar */
        .promo-bar {
            background: linear-gradient(90deg, #e11d48, #be185d, #4f46e5);
            color: #fff;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        /* Modern Navbar */
        .navbar-custom {
            background: #0f172a !important;
            backdrop-filter: blur(10px);
        }

        .navbar-brand-title {
            font-weight: 800;
            background: linear-gradient(135deg, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 1.4rem;
        }

        .nav-link-custom {
            color: #94a3b8 !important;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .nav-link-custom:hover {
                color: #f8fafc !important;
            }

        /* Modern Card Styling */
        .comic-card {
            border: none;
            border-radius: 16px;
            background: #ffffff;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow: hidden;
        }

            .comic-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 20px 30px rgba(0,0,0,0.08);
            }

        /* Buttons */
        .btn-brand {
            background-color: var(--primary-accent);
            color: #ffffff;
            font-weight: 700;
            border-radius: 10px;
            border: none;
            transition: all 0.2s ease;
        }

            .btn-brand:hover {
                background-color: var(--primary-hover);
                color: #ffffff;
                transform: scale(1.02);
            }

        .btn-checkout {
            background: linear-gradient(135deg, #10b981, #059669);
            color: #ffffff;
            font-weight: 700;
            border: none;
            border-radius: 12px;
        }

            .btn-checkout:hover {
                background: linear-gradient(135deg, #059669, #047857);
                color: #ffffff;
            }

        /* Floating Pill Badges */
        .badge-pill-custom {
            padding: 6px 12px;
            border-radius: 50rem;
            font-weight: 700;
            font-size: 0.75rem;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Promotional Announcement -->
    <div class="promo-bar text-center py-2 text-uppercase">
        <i class="bi bi-lightning-charge-fill me-1"></i> Midterm Special: Free Shipping on Orders Over $50!
    </div>

    <!-- Main Navigation -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Product" asp-action="Index">
                    <div class="bg-primary bg-gradient p-2 rounded-3 me-2 text-white d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="bi bi-journal-richtext fs-5"></i>
                    </div>
                    <span class="navbar-brand-title">MULTIVERSE</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap-fill me-1"></i> Storefront
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Checkout" asp-action="History">
                                <i class="bi bi-clock-history me-1"></i> Sales Log
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-outline-light rounded-pill px-4 fw-bold border-2" asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-bag-heart-fill me-2 text-danger"></i> Cart
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" class="flex-shrink-0 pb-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-auto py-4 bg-dark text-white border-top border-secondary border-opacity-25">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-2 mb-md-0">
                    <span class="fw-bold text-light">MULTIVERSE COMICS</span>
                    <small class="text-muted d-block">&copy; @DateTime.Now.Year Premium Graphic Novels & Rare Editions.</small>
                </div>
                <div class="col-md-6 text-md-end text-muted small">
                    <i class="bi bi-shield-check me-1 text-success"></i> Secure Checkout Guaranteed
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>